#!start included /usr/share/perl/5.40/ExtUtils/Manifest/Base.pm
\bRCS\b
\bCVS\b
\bSCCS\b
,v$
\B\.svn\b
\B\.git\b
\B\.gitignore\b
\b_darcs\b
\B\.cvsignore$

# Avoid Makefile generated by ExtUtils::MakeMaker
^MANIFEST\.
^Makefile$
^blib/
^blibdirs\.txt$
^pm_to_blib\.ts$
^pm_to_blib$
^blibdirs\.txt$

# Avoid Module::Build generated and utility files.
\bBuild$
\bBuild.bat$
\b_build/
\bBuild.COM$
\bBUILD.COM$
\bbuild.com$
^MYMETA\.

# Avoid archives of this distribution
#!end included /usr/share/perl/5.40/ExtUtils/Manifest/Base.pm

# 開発ツール・作業ファイル
^\.git/
^\.github/
^\.build/
\.DS_Store$

# GitHub Pages フロントエンド一式は Perl 配布物には不要
^web/
^docs/github-pages-search-plan\.md$
^t/2[1-7](\.|_)
^t/web_.*\.js$
^t/fixtures/web-data/

# author 向けメンテナンススクリプト
^author/
